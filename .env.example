# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string. For managed services that use connection pooling
# (Neon, Railway, Supabase), use the POOLED / proxy connection string here, not
# the direct connection — direct connections bypass the pooler and exhaust
# Postgres' max_connections limit on serverless deployments.
#   Neon:     use the "Pooled connection" string (ends in ?pgbouncer=true)
#   Railway:  use the proxy URL from the Variables tab, not the private URL
#   Supabase: Project Settings → Database → Connection string → Shared Pooler.
#             Use SESSION mode (port 5432), NOT transaction mode (6543):
#             openDb() pins the schema with the `options=-c search_path=…`
#             startup parameter, which transaction mode does not carry.
#             The pooler user embeds the project ref — `postgres.<project-ref>`.
#               postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#             Percent-encode reserved characters in the password, or psql and
#             db/migrations/run.sh will parse the URL differently than Node does:
#               @ → %40   / → %2F   ? → %3F   # → %23   [ → %5B   ] → %5D
# Verify whatever you put here with:  npm run db:check
DATABASE_URL=postgresql://finder:finder@localhost:5432/finder_dev

# Maximum Postgres connections per process instance. Tune based on your plan:
#   Local dev:              10  (default)
#   Neon / Railway free:    5   (25-connection limit ÷ up to 5 serverless instances)
#   Neon / Railway pro:     20  (scale with your plan's connection limit)
#   Supabase (free/small):  5   (the pooler's per-project client limit is shared
#                                across every process AND every tool — psql, the
#                                seed scripts and db:check all draw on it too)
# Formula: PG_POOL_MAX = floor(plan_max_connections / max_instances) - 2
PG_POOL_MAX=10
# Max milliseconds a single database STATEMENT may run before Postgres kills it
# (applied as `SET LOCAL statement_timeout` at BEGIN, so it covers each statement
# in the transaction separately — it is not a budget for the transaction as a
# whole; verified against PostgreSQL 16). Prevents runaway statements from
# holding row locks and exhausting the pool.
PG_TX_TIMEOUT_MS=30000
# Max milliseconds to wait for the migration advisory lock at boot before giving
# up with an explicit error. Concurrent instances queue here, so this bounds
# startup contention rather than any real work — the migrations themselves run
# under PG_TX_TIMEOUT_MS once the lock is held. Raise it if many instances boot
# at once against one database.
PG_MIGRATION_LOCK_WAIT_MS=300000
# SSL mode for Postgres. Defaults to enabled when NODE_ENV=production — which
# means it is OFF by default in development, so any managed provider that
# refuses plaintext (Supabase does) needs PG_SSL=true set explicitly even for
# local development. Supabase's pooler chain is publicly signed, so Node's
# bundled CAs verify it with no PG_CA_CERT needed.
# Set PG_SSL=false only for local CI/test Postgres that does not support SSL.
# TLS certificates are VERIFIED by default (C-3). For a private CA, provide the
# PEM via PG_CA_CERT (or base64 via PG_CA_CERT_B64). PG_SSL_NO_VERIFY=1 disables
# verification as a last resort — it logs a loud warning on every boot.
PG_SSL=
PG_CA_CERT=
PG_CA_CERT_B64=
PG_SSL_NO_VERIFY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be ≥ 32 random characters.
JWT_SECRET=change-me-min-32-chars-random-string

# ── App URLs (REQUIRED in production) ─────────────────────────────────────────
# Public URL of this backend service (used in CORS, email links, OAuth redirects).
APP_URL=http://localhost:3001
# URL the Next.js frontend uses to reach this backend (for server-side fetches).
BACKEND_URL=http://localhost:3001

# ── Security ──────────────────────────────────────────────────────────────────
# Number of trusted proxy hops between the internet and this server.
# Set to 1 for Vercel (1 proxy layer). Set to 2 for Cloudflare + Vercel.
# Controls X-Forwarded-For depth used by the rate limiter to extract real client IP.
TRUST_PROXY_DEPTH=1

# ── Webhook secret encryption (STRONGLY recommended in production) ─────────────
# 32 random bytes in hex (64 chars). Generate: openssl rand -hex 32
# If unset, webhook secrets are stored as plaintext (dev-only fallback).
WEBHOOK_SECRET_KEY=

# ── Background jobs (required in production — see the fail-closed note) ──────
# Background jobs (trial-expiry sweep, AR dunning, payment/inventory
# reconciliation, demand snapshots, reservation expiry, outbox retention) run
# when something calls GET /jobs/tick. An in-process poll timer also sweeps the
# outbox every 60s, but only on a host that keeps the process alive — it freezes
# between invocations on serverless. Set ONE of:
#   CRON_SECRET       — Vercel's own convention; Vercel Cron auto-sends
#                        `Authorization: Bearer <CRON_SECRET>` for you.
#   JOBS_TICK_SECRET  — for any other scheduler (Render cron, GitHub Actions,
#                        Kubernetes CronJob, curl); send as `X-Jobs-Tick-Secret`.
# Each secret is valid ONLY in its own transport — a JOBS_TICK_SECRET presented
# as a Bearer token is rejected, so rotating one does not widen the other.
# Unset both = endpoint disabled (fail-closed): in production it returns 503 and
# NO BACKGROUND JOBS RUN AT ALL. That is deliberate (an open job runtime is a
# remote trigger for every background mutation in the platform) — but it means
# setting neither is a silent outage of everything scheduled, not a soft default.
# See ADR-010.
#
# NOTE on cadence: vercel.json schedules the tick DAILY, so on Vercel the
# worst-case latency for outbox redelivery and every job is ~24h. On any other
# host, schedule it every 1-5 minutes.
CRON_SECRET=
JOBS_TICK_SECRET=

# ── Redis (optional — enables distributed rate limiting and durable EventBus) ──
# Without Redis, rate limiting is per-instance (in-memory) and EventBus events
# do not propagate across instances. Set this in production multi-instance deploys.
# Supported: redis://host:6379 or rediss://host:6380 (TLS).
REDIS_URL=

# ── Stripe (optional — required to accept card payments) ──────────────────────
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Register a Stripe Terminal reader in the Dashboard and put its ID here.
STRIPE_TERMINAL_READER_ID=
# Stripe webhook endpoint secret for signature verification (from webhook dashboard).
STRIPE_WEBHOOK_SECRET=

# ── Email (optional — dev mode logs to console if unset) ─────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=receipts@yourstore.com
EMAIL_WEBHOOK_URL=

# ── Observability ─────────────────────────────────────────────────────────────
# Bearer token required to scrape the /metrics endpoint (Prometheus).
# Leave empty to allow unauthenticated access (not recommended in production).
METRICS_TOKEN=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Store ─────────────────────────────────────────────────────────────────────
STORE_NAME=Ascend Demo

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Defaults to the Vercel
# deployment URLs if unset. In dev, all origins are permitted.
ALLOWED_ORIGINS=https://ascendhqweb.vercel.app

# ── Database tuning (scalability audit 2026-08-15) ───────────────────────────
# Per-statement timeout applied to EVERY connection via the pool's startup
# options, so it also covers queries outside an explicit transaction (those had
# no timeout at all before). Defaults to PG_TX_TIMEOUT_MS.
# PG_STATEMENT_TIMEOUT_MS=30000
# Kills sessions holding an open transaction without doing work, so a client
# that dies mid-transaction cannot pin its locks and block VACUUM.
# PG_IDLE_TX_TIMEOUT_MS=60000
# Single-statement fast path: keeps app.tenant_id/app.request_id on the pooled
# connection instead of wrapping every query in its own transaction (4 round
# trips → 1). Auto-disabled for a transaction-mode pooler (Supabase port 6543),
# where session state cannot be relied on. "off" forces the conservative path.
# PG_SESSION_CTX=auto
# Readiness: a queue for pool connections is normal under load and no longer
# fails /readyz. Only a queue deeper than this multiple of PG_POOL_MAX does.
# PG_READY_MAX_WAITING=10

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per-IP limiter in front of everything. Raise when a whole customer site
# arrives through one NAT/proxy address, or when TRUST_PROXY_DEPTH cannot
# resolve the real client IP.
# GLOBAL_RATE_LIMIT_CAPACITY=120
# GLOBAL_RATE_LIMIT_REFILL=40
