{
  "name": "ascend",
  "version": "2.0.0",
  "description": "Ascend - Year 1 Foundation (modular monolith). Offline-first POS backend on Postgres.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
    "db:setup": "bash scripts/db-setup.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "hygiene": "node tools/hygiene-check.mjs",
    "ops:check": "tsx scripts/ops-check.ts",
    "prevent:drift": "node tools/prevention-agent.mjs",
    "gap:scan": "node tools/api-gap-scan.mjs",
    "contract:scan": "node tools/openapi-contract-scan.mjs",
    "authz:scan": "node tools/route-authz-scan.mjs",
    "table:scan": "node tools/table-collision-scan.mjs",
    "dupe:scan": "node tools/duplicate-code-scan.mjs",
    "dead:scan": "node tools/dead-code-scan.mjs",
    "dashboard": "node tools/dashboard.mjs",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "business:matrix": "tsx scripts/generate-business-pack-matrix.ts",
    "verify": "npm run hygiene && npm run gap:scan && npm run contract:scan && npm run authz:scan && npm run table:scan && npm run typecheck && npm test && npm run smoke && npm --prefix web run typecheck && npm --prefix web run lint && npm --prefix web run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "stripe": "22.4.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3"
  }
}
