# Ascend POS — Environment Variables Reference
# Copy this file to .env.local and fill in the values.
# Variables prefixed with VITE_ are bundled into the frontend at build time.

# ------------------------------------------------------------------
# Frontend (artifacts/ascend)
# ------------------------------------------------------------------

# Base URL of the API server. Leave empty to use same-origin routing
# (correct for Replit path-based routing where /api/* routes to api-server).
VITE_API_BASE_URL=

# Set to "false" to disable MSW mocking and hit the real API.
# Set to "true" (default) for demo/offline mode without a backend.
VITE_MOCK=false

# ------------------------------------------------------------------
# Backend (artifacts/api-server)
# ------------------------------------------------------------------

# PostgreSQL connection string (auto-provisioned by Replit — do not set manually).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Secret used to encrypt HTTP sessions.
SESSION_SECRET=

# Optional: Redis connection string for caching and pub-sub.
# REDIS_URL=redis://localhost:6379

# Optional: Stripe secret key for payments.
# STRIPE_SECRET_KEY=sk_live_...
