{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:quiet-hours": "tsx --test src/modules/push_tokens/*.test.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "db:backup:remote-list": "tsx src/scripts/remote-backups.ts list",
    "db:backup:remote-pull": "tsx src/scripts/remote-backups.ts pull",
    "db:verify-restore": "tsx src/scripts/verify-restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "otpauth": "^9.5.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "stripe": "22.2.2",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
